# ─────────────────────────────────────────────────────────────
# Persistencia: Google Sheets vía Google Apps Script Web App
# ─────────────────────────────────────────────────────────────
# Copia este archivo como  .env  y rellena los valores reales.
# (.env está en .gitignore; .env.example NO debe llevar secretos.)
#
# Publica el script de /docs/apps-script.gs como "Aplicación web"
# ("Quién tiene acceso: Cualquier usuario") y pega aquí la URL /exec.
GOOGLE_SHEETS_WEBHOOK_URL=

# Token compartido: debe coincidir EXACTAMENTE con SHARED_TOKEN dentro del Apps Script.
GOOGLE_SHEETS_TOKEN=

# ─────────────────────────────────────────────────────────────
# Modo desarrollo / respaldo sin Google Sheets
# ─────────────────────────────────────────────────────────────
# Si GOOGLE_SHEETS_WEBHOOK_URL está vacío, las funciones usan esta
# lista separada por comas como padrón de cédulas autorizadas.
ALLOWLIST_CEDULAS=1234567890,1098765432,10203040

# Duración del examen en minutos (por defecto 60).
EXAM_DURATION_MINUTES=60
